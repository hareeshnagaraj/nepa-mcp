# Optional Census API key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Optional EPA AQS credentials: https://aqs.epa.gov/data/api/signup
EPA_AQS_EMAIL=
EPA_AQS_API_KEY=

# Optional Map Composer artifact directory. Defaults to the operating system's
# private per-user data directory under nepa-mcp/artifacts/map_composer.
NEPA_MCP_OUTPUT_DIR=
